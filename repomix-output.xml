<file path="src/features/virtualTryOn/GarmentOverlay.tsx">
import {
  Component,
  Suspense,
  useCallback,
  useEffect,
  useMemo,
  useRef,
  useState,
} from 'react'
import type { ReactNode, RefObject } from 'react'
import { Canvas, useFrame } from '@react-three/fiber'
import { useGLTF } from '@react-three/drei'
import * as THREE from 'three'
import { clone } from 'three/addons/utils/SkeletonUtils.js'
import { isVisible } from '../pose/poseGeometry'
import type { PoseFrame, PoseSource } from '../pose/poseTypes'
import type { Garment } from '../wardrobe/garments'

const MODEL_URL = `${import.meta.env.BASE_URL}garments/tshirt.glb`
// Preserve the existing asset calibration; the GLB is not included in Repomix.
const MODEL_SCALE = 0.05
const MODEL_OFFSET_Y = -1.5

const TRACKING = {
  hideConfidence: 0.5,
  showConfidence: 0.65,
  hideWidth: 0.08,
  showWidth: 0.1,
  hideProjectionRatio: Math.cos((70 * Math.PI) / 180),
  showProjectionRatio: Math.cos((60 * Math.PI) / 180),
  reacquireMs: 150,
  reacquireSamples: 3,
  maxGapMs: 250,
  staleMs: 500,
  smoothingRate: 14,
} as const

type ModelState = 'loading' | 'ready' | 'error'

interface ShoulderPose {
  timestamp: number
  width: number
  height: number
  midX: number
  midY: number
  shoulderWidthRatio: number
  projectionRatio: number
  confidence: number
  yaw: number
  roll: number
}

function measureShoulders(frame: PoseFrame): ShoulderPose | null {
  const { width, height, landmarks, timestamp } = frame
  if (![width, height].every((v) => Number.isFinite(v) && v > 0)) return null
  const left = landmarks[11]
  const right = landmarks[12]
  if (
    !isVisible(left) ||
    !isVisible(right) ||
    !Number.isFinite(left.z) ||
    !Number.isFinite(right.z)
  ) return null

  // Anatomical right -> left, in UNMIRRORED video coordinates.
  // x and y must be converted using their respective video dimensions.
  const dx = (left.x - right.x) * width
  const dy = (left.y - right.y) * height
  const depthDiff = (left.z - right.z) * width
  const shoulderWidthPx = Math.hypot(dx, dy)
  // This is a relative-depth proxy, NOT a shoulder measurement in meters.
  const shoulderWidth3D = Math.hypot(shoulderWidthPx, depthDiff)
  if (
    dx <= 0 ||
    shoulderWidthPx <= 0 ||
    !Number.isFinite(shoulderWidth3D)
  ) return null
  // dx <= 0 conservatively rejects reversed shoulders for upright front fitting.
  // Two shoulders alone are not a general-purpose front/back classifier.

  return {
    timestamp,
    width,
    height,
    midX: (left.x + right.x) / 2,
    midY: (left.y + right.y) / 2,
    shoulderWidthRatio: shoulderWidthPx / width,
    projectionRatio: shoulderWidthPx / shoulderWidth3D,
    confidence: Math.min(
      left.visibility,
      right.visibility,
      left.presence ?? 1,
      right.presence ?? 1,
    ),
    // Three.js: y is up and positive z points toward this camera.
    // Rz(roll) * Ry(yaw) maps local +x onto (dx, -dy, -depthDiff).
    yaw: Math.atan2(depthDiff, shoulderWidthPx),
    roll: Math.atan2(-dy, dx),
  }
}

/** Consume inference frames once, rather than counting repeated R3F frames. */
function createShoulderTracker(onPose: (pose: ShoulderPose | null) => void) {
  let visible = false
  let goodSince: number | null = null
  let goodSamples = 0
  let lastTimestamp = -Infinity
  let lastWidth = 0
  let lastHeight = 0
  let expiry: number | undefined

  function cancelExpiry() {
    if (expiry !== undefined) window.clearTimeout(expiry)
    expiry = undefined
  }
  function hide() {
    visible = false
    goodSince = null
    goodSamples = 0
    onPose(null)
  }
  function reset() {
    cancelExpiry()
    hide()
    lastTimestamp = -Infinity
    lastWidth = 0
    lastHeight = 0
  }
  function push(frame: PoseFrame | null) {
    if (!frame) {
      reset()
      return
    }
    const age = performance.now() - frame.timestamp
    if (
      document.hidden ||
      !Number.isFinite(age) ||
      age < 0 ||
      age >= TRACKING.staleMs
    ) {
      reset()
      return
    }
    // Duplicates/out-of-order frames neither advance recovery nor renew expiry.
    if (frame.timestamp <= lastTimestamp) return
    cancelExpiry()
    if (
      frame.timestamp - lastTimestamp > TRACKING.maxGapMs ||
      frame.width !== lastWidth ||
      frame.height !== lastHeight
    ) hide()
    lastTimestamp = frame.timestamp
    lastWidth = frame.width
    lastHeight = frame.height

    const pose = measureShoulders(frame)
    const confidence = visible ? TRACKING.hideConfidence : TRACKING.showConfidence
    const width = visible ? TRACKING.hideWidth : TRACKING.showWidth
    const ratio = visible
      ? TRACKING.hideProjectionRatio
      : TRACKING.showProjectionRatio
    if (
      !pose ||
      pose.confidence < confidence ||
      pose.shoulderWidthRatio < width ||
      pose.projectionRatio < ratio
    ) {
      hide()
      return
    }
    if (!visible) {
      goodSince ??= pose.timestamp
      goodSamples += 1
      visible =
        goodSamples >= TRACKING.reacquireSamples &&
        pose.timestamp - goodSince >= TRACKING.reacquireMs
    }
    onPose(visible ? pose : null)
    // Also expire a replayed channel frame using its capture time, not receipt time.
    expiry = window.setTimeout(reset, TRACKING.staleMs - age)
  }
  return { push, reset, dispose: cancelExpiry }
}

function GarmentModel({
  targetRef,
  onReady,
}: {
  targetRef: RefObject<ShoulderPose | null>
  onReady: () => void
}) {
  const { scene } = useGLTF(MODEL_URL)
  const root = useMemo(() => {
    const anchor = new THREE.Group()
    anchor.visible = false
    const calibration = new THREE.Group()
    calibration.position.y = MODEL_OFFSET_Y
    calibration.scale.setScalar(MODEL_SCALE)
    // Do not move/reparent the GLTF cache's shared scene; also support skinned GLBs.
    calibration.add(clone(scene))
    anchor.add(calibration)
    return anchor
  }, [scene])
  const targetPosition = useMemo(() => new THREE.Vector3(), [])
  const targetRotation = useMemo(() => new THREE.Quaternion(), [])
  const euler = useMemo(() => new THREE.Euler(0, 0, 0, 'ZYX'), [])
  const lastDrawn = useRef(-Infinity)

  useEffect(() => {
    onReady()
    return () => {
      root.traverse((object) => {
        if (object instanceof THREE.SkinnedMesh) object.skeleton.dispose()
      })
    }
  }, [onReady, root])

  useFrame(({ size, viewport }, delta) => {
    const pose = targetRef.current
    if (
      !pose ||
      document.hidden ||
      performance.now() - pose.timestamp >= TRACKING.staleMs ||
      size.width <= 0 ||
      size.height <= 0
    ) {
      root.visible = false
      lastDrawn.current = -Infinity
      return
    }
    // Match the video's object-fit: contain, including letterbox/pillarbox bars.
    const fit = Math.min(size.width / pose.width, size.height / pose.height)
    const videoWidth = pose.width * fit
    const videoHeight = pose.height * fit
    const px = (size.width - videoWidth) / 2 + pose.midX * videoWidth
    const py = (size.height - videoHeight) / 2 + pose.midY * videoHeight
    targetPosition.set(
      (px / size.width - 0.5) * viewport.width,
      (0.5 - py / size.height) * viewport.height,
      0,
    )
    targetRotation.setFromEuler(euler.set(0, pose.yaw, pose.roll, 'ZYX'))
    if (!root.visible || pose.timestamp - lastDrawn.current > TRACKING.maxGapMs) {
      root.position.copy(targetPosition)
      root.quaternion.copy(targetRotation)
    } else {
      const alpha = 1 - Math.exp(-TRACKING.smoothingRate * Math.max(0, delta))
      root.position.lerp(targetPosition, alpha)
      root.quaternion.slerp(targetRotation, alpha)
    }
    lastDrawn.current = pose.timestamp
    root.visible = true
  })

  // Geometry/materials belong to the useGLTF cache, so do not dispose them here.
  return <primitive object={root} dispose={null} />
}

class ModelErrorBoundary extends Component<
  { children: ReactNode; onError: () => void },
  { failed: boolean }
> {
  state = { failed: false }
  static getDerivedStateFromError() {
    return { failed: true }
  }
  componentDidCatch() {
    this.props.onError()
  }
  render() {
    return this.state.failed ? null : this.props.children
  }
}

function WebGLFallback({ onError }: { onError: () => void }) {
  useEffect(onError, [onError])
  return null
}

export function GarmentOverlay({
  source,
  garment,
  mirrored,
}: {
  source: PoseSource
  garment: Garment
  mirrored: boolean
}) {
  const targetRef = useRef<ShoulderPose | null>(null)
  const [tracking, setTracking] = useState(false)
  const [modelState, setModelState] = useState<ModelState>('loading')
  const [attempt, setAttempt] = useState(0)
  const onReady = useCallback(() => setModelState('ready'), [])
  const onError = useCallback(() => setModelState('error'), [])

  useEffect(() => {
    let reported: boolean | undefined
    const tracker = createShoulderTracker((pose) => {
      targetRef.current = pose
      const next = pose !== null
      if (next !== reported) {
        reported = next
        setTracking(next)
      }
    })
    tracker.reset()
    const unsubscribe = source.subscribe(tracker.push)
    const onVisibility = () => {
      if (document.hidden) tracker.reset()
    }
    document.addEventListener('visibilitychange', onVisibility)
    return () => {
      unsubscribe()
      tracker.dispose()
      targetRef.current = null
      document.removeEventListener('visibilitychange', onVisibility)
    }
  }, [source])

  function retry() {
    useGLTF.clear(MODEL_URL)
    setModelState('loading')
    setAttempt((value) => value + 1)
  }

  const message =
    modelState === 'error'
      ? '3Dモデルを表示できません。GLBの配置とWebGLを確認してください。'
      : modelState === 'loading'
        ? '3Dモデルを読み込んでいます…'
        : tracking
          ? `${garment.name} · 3D試着中`
          : '正面を向いて両肩を映し、少し静止してください。遠い場合はカメラに近づいてください。'

  return (
    <>
      <div className="pose-canvas garment-canvas" aria-label="試着する服">
        <ModelErrorBoundary key={attempt} onError={onError}>
          <Canvas
            camera={{ position: [0, 0, 5], fov: 50 }}
            gl={{ alpha: true, antialias: true }}
            fallback={<WebGLFallback onError={onError} />}
          >
            <ambientLight intensity={1} />
            <directionalLight position={[0, 0, 5]} intensity={1.5} />
            <directionalLight position={[-5, 5, 2]} intensity={0.5} />
            <Suspense fallback={null}>
              <GarmentModel targetRef={targetRef} onReady={onReady} />
            </Suspense>
          </Canvas>
        </ModelErrorBoundary>
      </div>
      {/* CameraView already mirrors the parent; only unmirror the feedback text. */}
      <div className={`garment-feedback ${mirrored ? 'is-mirrored' : ''}`}>
        <p className="pose-message" role="status">{message}</p>
        {modelState === 'error' && (
          <button type="button" className="pose-retry" onClick={retry}>
            3Dモデルを再読み込み
          </button>
        )}
      </div>
    </>
  )
}
</file>

<file path="src/features/virtualTryOn/garmentTransform.test.ts">
import { describe, expect, it } from 'vitest'
import { calculateGarmentTransform } from './garmentTransform'
import type { GarmentTransform } from './garmentTransform'
import type { Garment } from '../wardrobe/garments'
import { makePoseFrame } from '../../test/poseFixture'

// Fixed geometry fixture: placement expectations must not depend on the demo asset.
const demoGarment: Garment = {
  id: 'geometry-fixture',
  name: 'Geometry fixture',
  image: '',
  gender: 'unisex',
  category: 'tshirt',
  anchors: {
    leftShoulder: { x: 0.7, y: 0.2 },
    rightShoulder: { x: 0.3, y: 0.2 },
    leftHip: { x: 0.7, y: 0.8 },
    rightHip: { x: 0.3, y: 0.8 },
  },
  scaleX: 1,
  scaleY: 1,
  offsetX: 0,
  offsetY: 0,
  rotationOffset: 0,
}

const project = (m: GarmentTransform, x: number, y: number) => ({
  x: m.a * x + m.c * y + m.e,
  y: m.b * x + m.d * y + m.f,
})
describe('garment placement', () => {
  it('fits shoulders and torso in pixel space, without requiring wrists', () => {
    const transform = calculateGarmentTransform(
      makePoseFrame(),
      demoGarment,
      800,
      800,
    )!
    expect(project(transform, 560, 160)).toEqual({ x: 800, y: 180 })
    expect(project(transform, 240, 160)).toEqual({ x: 480, y: 180 })
    expect(project(transform, 400, 640)).toEqual({ x: 640, y: 540 })
    expect(transform.a).toBeGreaterThan(0) // Anatomical left is image-right.
    expect(transform.d).toBeGreaterThan(0)
  })
  it('follows translation, tilt and distance using non-square video dimensions', () => {
    const original = makePoseFrame()
    const angle = Math.PI / 8,
      scale = 0.7
    const moved = {
      ...original,
      landmarks: original.landmarks.map((p) => {
        const x = p.x * original.width - 640,
          y = p.y * original.height - 360
        return {
          ...p,
          x:
            (700 + scale * (Math.cos(angle) * x - Math.sin(angle) * y)) /
            original.width,
          y:
            (350 + scale * (Math.sin(angle) * x + Math.cos(angle) * y)) /
            original.height,
        }
      }),
    }
    const transform = calculateGarmentTransform(moved, demoGarment, 800, 800)!
    for (const [index, x, y] of [
      [11, 560, 160],
      [12, 240, 160],
      [23, 560, 640],
      [24, 240, 640],
    ]) {
      const actual = project(transform, x, y)
      expect(actual.x).toBeCloseTo(moved.landmarks[index].x * moved.width)
      expect(actual.y).toBeCloseTo(moved.landmarks[index].y * moved.height)
    }
  })
  it('keeps shoulder center fixed while applying size and offset calibration', () => {
    const frame = makePoseFrame()
    const transform = calculateGarmentTransform(
      frame,
      { ...demoGarment, scaleX: 1.2, scaleY: 1.1, offsetX: 0.1, offsetY: 0.1 },
      800,
      800,
    )!
    expect(project(transform, 400, 160)).toEqual({ x: 672, y: 216 })
  })
  it('hides on lost shoulders/hips, invalid values, or degenerate/back-facing poses', () => {
    for (const index of [11, 12, 23, 24]) {
      const frame = makePoseFrame()
      frame.landmarks[index].visibility = 0.2
      expect(calculateGarmentTransform(frame, demoGarment, 800, 800)).toBeNull()
    }
    const frame = makePoseFrame()
    frame.landmarks[11].x = frame.landmarks[12].x
    expect(calculateGarmentTransform(frame, demoGarment, 800, 800)).toBeNull()
    const back = makePoseFrame()
    back.landmarks[11].x = 0.375
    back.landmarks[12].x = 0.625
    expect(calculateGarmentTransform(back, demoGarment, 800, 800)).toBeNull()
    expect(
      calculateGarmentTransform(makePoseFrame(), demoGarment, 0, 800),
    ).toBeNull()
    expect(
      calculateGarmentTransform(
        makePoseFrame(),
        { ...demoGarment, scaleY: NaN },
        800,
        800,
      ),
    ).toBeNull()
  })
})
</file>

<file path="src/features/wardrobe/GarmentSelector.tsx">
import { useId } from 'react'
import { garmentGenderLabels } from './garments'
import type { Garment, GarmentFilter } from './garments'

const filters: readonly { value: GarmentFilter; label: string }[] = [
  { value: 'men', label: '男性' },
  { value: 'women', label: '女性' },
  { value: 'all', label: '全て' },
]

export function GarmentSelector({
  garments,
  index,
  filter,
  onFilterChange,
  onSelect,
}: {
  garments: readonly Garment[]
  index: number
  filter: GarmentFilter
  onFilterChange: (filter: GarmentFilter) => void
  onSelect: (index: number) => void
}) {
  const groupId = useId()
  const garment = garments[index]
  return (
    <div className="wardrobe" aria-label="服を選ぶ">
      <fieldset className="garment-filter" aria-describedby={`${groupId}-hint`}>
        <legend>服のカテゴリ</legend>
        <div className="garment-filter-options">
          {filters.map((option) => (
            <label key={option.value}>
              <input
                type="radio"
                name={groupId}
                value={option.value}
                checked={filter === option.value}
                onChange={() => onFilterChange(option.value)}
              />
              <span>{option.label}</span>
            </label>
          ))}
        </div>
        <p id={`${groupId}-hint`} className="garment-filter-hint">
          共用の服は、男性・女性の両方に表示します。
        </p>
      </fieldset>
      {garment ? (
        <>
          <div className="garment-preview">
            <img
              key={garment.id}
              src={garment.image}
              alt={`${garment.name}の透過素材`}
            />
            <div aria-live="polite" aria-atomic="true">
              <span className="garment-count">
                {index + 1} / {garments.length}
              </span>
              <strong>{garment.name}</strong>
              <span className="garment-gender">
                {garmentGenderLabels[garment.gender]}
              </span>
            </div>
          </div>
          <div className="wardrobe-buttons">
            <button
              type="button"
              disabled={garments.length < 2}
              onClick={() =>
                onSelect((index - 1 + garments.length) % garments.length)
              }
            >
              前の服
            </button>
            <button
              type="button"
              disabled={garments.length < 2}
              onClick={() => onSelect((index + 1) % garments.length)}
            >
              次の服
            </button>
          </div>
          <div className="garment-thumbnails">
            {garments.map((item, itemIndex) => (
              <button
                key={item.id}
                type="button"
                aria-label={`${item.name}を選ぶ`}
                aria-pressed={itemIndex === index}
                onClick={() => onSelect(itemIndex)}
              >
                <img src={item.image} alt="" />
              </button>
            ))}
          </div>
        </>
      ) : (
        <p className="garment-empty" role="status">
          このカテゴリの服はまだありません。別のカテゴリを選んでください。
        </p>
      )}
    </div>
  )
}
