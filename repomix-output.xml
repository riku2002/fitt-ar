import { act, render, screen } from '@testing-library/react'
import { afterEach, beforeEach, expect, it, vi } from 'vitest'
import type { ReactNode } from 'react'
import { useFrame } from '@react-three/fiber'
import type { RootState } from '@react-three/fiber'
import { clone } from 'three/addons/utils/SkeletonUtils.js'
import * as THREE from 'three'
import { createPoseChannel } from '../pose/poseChannel'
import type { PoseFrame } from '../pose/poseTypes'
import { demoGarment } from '../wardrobe/garments'
import { makePoseFrame } from '../../test/poseFixture'
import { GarmentOverlay } from './GarmentOverlay'

// Mock WebGL/loading, but exercise the actual tracker and Three.js transforms.
vi.mock('@react-three/fiber', async () => {
  const { createElement, Fragment } = await import('react')
  return {
    Canvas: ({ children }: { children: ReactNode }) =>
      createElement(Fragment, null, children),
    useFrame: vi.fn(),
  }
})
vi.mock('@react-three/drei', async () => {
  const { Group } = await import('three')
  const scene = new Group()
  return { useGLTF: Object.assign(vi.fn(() => ({ scene })), { clear: vi.fn() }) }
})
vi.mock('three/addons/utils/SkeletonUtils.js', async (importOriginal) => {
  const original = await importOriginal<
    typeof import('three/addons/utils/SkeletonUtils.js')
  >()
  return { ...original, clone: vi.fn(original.clone) }
})

let now = 1000
beforeEach(() => {
  now = 1000
  vi.useFakeTimers()
  vi.spyOn(performance, 'now').mockImplementation(() => now)
})
afterEach(() => {
  vi.restoreAllMocks()
  vi.useRealTimers()
})

function draw() {
  const callback = vi.mocked(useFrame).mock.calls.at(-1)?.[0]
  if (!callback) throw new Error('No R3F frame callback was registered')
  act(() => callback({
    size: { width: 640, height: 480 },
    viewport: { width: 8, height: 6 },
  } as RootState, 1 / 60))
}
function modelRoot(): THREE.Object3D {
  const result = vi.mocked(clone).mock.results.at(-1)
  if (!result || result.type !== 'return') throw new Error('No cloned model')
  const model: THREE.Object3D = result.value
  if (!model.parent?.parent) throw new Error('No shoulder anchor')
  return model.parent.parent
}
function emit(
  source: ReturnType<typeof createPoseChannel>,
  frame: PoseFrame | null,
  timestamp = now + 80,
) {
  now = timestamp
  act(() => source.publish(frame ? { ...frame, timestamp } : null))
  draw()
}
function acquire(
  source: ReturnType<typeof createPoseChannel>,
  frame = makePoseFrame(),
) {
  emit(source, frame)
  emit(source, frame)
  emit(source, frame)
}
function setup(mirrored = true) {
  const source = createPoseChannel()
  const view = render(
    <GarmentOverlay source={source} garment={demoGarment} mirrored={mirrored} />,
  )
  return { source, view }
}

it('starts hidden, waits for fresh stable samples, and respects contain bars', () => {
  const { source } = setup()
  expect(modelRoot().visible).toBe(false)
  emit(source, makePoseFrame())
  emit(source, makePoseFrame())
  expect(modelRoot().visible).toBe(false)
  emit(source, makePoseFrame())
  expect(modelRoot().visible).toBe(true)
  expect(screen.getByText(/3D試着中/)).toBeInTheDocument()
  // 1280x720 video inside 640x480 -> 60px top/bottom bars.
  expect(modelRoot().position.x).toBeCloseTo(0)
  expect(modelRoot().position.y).toBeCloseTo(1.125)
})

it.each([
  { visibility: 0.49 },
  { presence: 0.49 },
  { visibility: Infinity },
  { z: NaN },
  { z: undefined },
  { x: 1.1 },
])('hides instead of applying invalid shoulder data: %j', (override) => {
  const { source } = setup()
  acquire(source)
  const invalid = makePoseFrame()
  Object.assign(invalid.landmarks[11], override)
  emit(source, invalid)
  expect(modelRoot().visible).toBe(false)
  expect(screen.getByText(/正面を向いて/)).toBeInTheDocument()
})

it('uses different hide/show thresholds to avoid rapid visibility toggles', () => {
  const { source } = setup()
  acquire(source)
  const borderline = makePoseFrame()
  borderline.landmarks[11].x = 0.545
  borderline.landmarks[12].x = 0.455
  borderline.landmarks[11].visibility = 0.6
  emit(source, borderline)
  expect(modelRoot().visible).toBe(true)
  const narrow = makePoseFrame()
  narrow.landmarks[11].x = 0.535
  narrow.landmarks[12].x = 0.465
  emit(source, narrow)
  expect(modelRoot().visible).toBe(false)
  acquire(source, borderline)
  expect(modelRoot().visible).toBe(false)
  acquire(source)
  expect(modelRoot().visible).toBe(true)
})

it('rejects a depth-dominated shoulder vector even when its image width is large', () => {
  const { source } = setup()
  acquire(source)
  const sideways = makePoseFrame()
  sideways.landmarks[11].z = 1
  emit(source, sideways)
  expect(modelRoot().visible).toBe(false)
})

it('preserves depth sign and computes roll using video pixels', () => {
  const { source } = setup()
  const tilted = makePoseFrame()
  tilted.landmarks[11].y = 0.35
  tilted.landmarks[11].z = -0.1
  tilted.landmarks[12].z = 0.1
  acquire(source, tilted)
  const actual = new THREE.Vector3(1, 0, 0).applyQuaternion(modelRoot().quaternion)
  const expected = new THREE.Vector3(320, -72, 256).normalize()
  expect(actual.distanceTo(expected)).toBeLessThan(1e-10)
})

it('clears null/stalled poses, and never mirrors coordinates a second time', () => {
  const { source, view } = setup(true)
  const shifted = makePoseFrame()
  shifted.landmarks[11].x += 0.1
  shifted.landmarks[12].x += 0.1
  acquire(source, shifted)
  expect(modelRoot().position.x).toBeCloseTo(0.8)
  view.rerender(
    <GarmentOverlay source={source} garment={demoGarment} mirrored={false} />,
  )
  draw()
  expect(modelRoot().position.x).toBeCloseTo(0.8)
  emit(source, null)
  expect(modelRoot().visible).toBe(false)
  acquire(source)
  now += 501
  act(() => vi.advanceTimersByTime(501))
  draw()
  expect(modelRoot().visible).toBe(false)
  expect(screen.getByText(/正面を向いて/)).toBeInTheDocument()
})
