    </main>
    <script>
      const $ = (id) => document.getElementById(id)
      const keys = ['leftShoulder', 'rightShoulder', 'leftHip', 'rightHip']
      const labels = [
        '① 左肩（画像の右）',
        '② 右肩（画像の左）',
        '③ 左腰（画像の右）',
        '④ 右腰（画像の左）',
      ]
      const demoPoints = [
        { x: 0.78, y: 0.14 },
        { x: 0.22, y: 0.14 },
        { x: 0.72, y: 0.88 },
        { x: 0.28, y: 0.88 },
      ]
      let points = [],
        active = 0,
        ready = false,
        request = 0,
        objectUrl = null,
        cursor = { x: 0.5, y: 0.5 }
      const pointButtons = labels.map((label, i) => {
        const button = document.createElement('button')
        button.type = 'button'
        button.addEventListener('click', () => {
          active = i
          cursor = points[i] ?? { x: 0.5, y: 0.5 }
          update()
        })
        $('points').append(button)
        return button
      })
      function update() {
        $('stage')
          .querySelectorAll('.point')
          .forEach((node) => node.remove())
        pointButtons.forEach((button, i) => {
          button.textContent = labels[i] + (points[i] ? ' ✓' : '')
          button.setAttribute('aria-pressed', String(i === active))
          button.disabled = !ready
          if (!points[i]) return
          const dot = document.createElement('span')
          dot.className = 'marker point' + (i > 1 ? ' hip' : '')
          dot.textContent = String(i + 1)
          dot.style.left = points[i].x * 100 + '%'
          dot.style.top = points[i].y * 100 + '%'
          $('stage').append(dot)
        })
        $('next').textContent = !ready
          ? '先に透過PNGを選んでください。'
          : points.filter(Boolean).length < 4
            ? '次は ' + labels[active] + ' をクリック。'
            : '4点を指定できました。配置を確認し、必要なら点を選んで修正してください。'
        $('cursor').hidden = true
        $('output').value = ''
        $('copy').disabled = true
        $('copy-status').textContent = ''
        $('validation').textContent = ''
        if (!ready || points.filter(Boolean).length < 4) return
        const [ls, rs, lh, rh] = points
        if (
          ls.x <= rs.x ||
          lh.x <= rh.x ||
          (lh.y + rh.y - ls.y - rs.y) / 2 < 0.05
        ) {
          $('validation').textContent =
            '左右または上下が逆です。①③は画像の右、②④は左、腰は肩より下に指定してください。'
          return
        }
        const filename = $('filename').value.trim(),
          name = $('name').value.trim()
        if (!/^[a-z0-9][a-z0-9-]*\.png$/.test(filename) || !name) {
          $('validation').textContent =
            '表示名と、半角小文字・数字・ハイフンのファイル名（例: my-tshirt.png）を入力してください。'
          return
        }
        const anchors = Object.fromEntries(
          keys.map((key, i) => [key, points[i]]),
        )
        const metadata = {
          id: filename.slice(0, -4),
          name,
          image: '',
          gender: $('gender').value,
          category: 'tshirt',
          anchors,
          scaleX: 1,
          scaleY: 1,
          offsetX: 0,
          offsetY: 0,
          rotationOffset: 0,
        }
        $('output').value =
          'export const demoGarment: Garment = ' +
          JSON.stringify(metadata, null, 2).replace(
            '"image": ""',
            '"image": `${import.meta.env.BASE_URL}garments/' + filename + '`',
          )
        $('copy').disabled = false
        $('validation').textContent =
          '設定をコピーできます。画像ファイルの配置も忘れずに。'
      }
      function clear() {
        points = []
        active = 0
        update()
      }
      function place(x, y) {
        if (!ready) return
        points[active] = {
          x: Math.round(Math.max(0, Math.min(1, x)) * 10000) / 10000,
          y: Math.round(Math.max(0, Math.min(1, y)) * 10000) / 10000,
        }
        const missing = keys.findIndex((_, i) => !points[i])
        if (missing >= 0) active = missing
        update()
      }
      async function load(file) {
        const id = ++request
        ready = false
        $('stage').hidden = true
        $('status').textContent = '画像を確認しています…'
        clear()
        let candidateUrl
        try {
          let url = '../garments/tshirt-gray.png'
          if (file) {
            if (file.size > 10 * 1024 * 1024)
              throw new Error(
                '10MB以下のPNGにしてください。長辺1,000〜1,600pxが目安です。',
              )
            const bytes = new Uint8Array(await file.slice(0, 24).arrayBuffer())
            if (
              bytes.length < 24 ||
              ![137, 80, 78, 71, 13, 10, 26, 10].every((v, i) => bytes[i] === v)
            )
              throw new Error(
                'PNGファイルを選んでください。JPEGの拡張子を変えるだけでは透過PNGになりません。',
              )
            const header = new DataView(bytes.buffer)
            if (header.getUint32(16) > 4096 || header.getUint32(20) > 4096)
              throw new Error(
                '長辺を4,096px以下に縮小してください。おすすめは1,000〜1,600pxです。',
              )
            candidateUrl = URL.createObjectURL(file)
            url = candidateUrl
          }
          const image = new Image()
          image.src = url
          await image.decode()
          if (id !== request) return
          const canvas = document.createElement('canvas')
          canvas.width = image.naturalWidth
          canvas.height = image.naturalHeight
          const context = canvas.getContext('2d')
          context.drawImage(image, 0, 0)
          const pixels = context.getImageData(
            0,
            0,
            canvas.width,
            canvas.height,
          ).data
          let transparent = 0,
            visible = 0
          for (let i = 3; i < pixels.length; i += 4) {
            if (pixels[i] === 0) transparent++
            if (pixels[i] > 0) visible++
          }
          if (!transparent)
            throw new Error(
              '背景が透過されていません。背景を削除してPNGで書き出してください。',
            )
          if (!visible)
            throw new Error(
              '画像がすべて透明です。Tシャツのレイヤーを表示して書き出してください。',
            )
          if (objectUrl) URL.revokeObjectURL(objectUrl)
          objectUrl = candidateUrl ?? null
          candidateUrl = null
          $('photo').src = url
          $('stage').hidden = false
          ready = true
          $('name').value = file ? '自分のTシャツ' : 'Tシャツ / Heather Gray'
          $('gender').value = 'unisex'
          $('filename').value = file
            ? /^[a-z0-9][a-z0-9-]*\.png$/.test(file.name)
              ? file.name
              : 'my-tshirt.png'
            : 'tshirt-gray.png'
          if (!file) points = demoPoints.map((p) => ({ ...p }))
          $('status').textContent =
            `${file ? '選択した画像' : 'デモの設定例'} · ${canvas.width} × ${canvas.height}px · 透過あり`
          update()
        } catch (error) {
          if (id === request)
            $('status').textContent =
              error instanceof Error
                ? error.message
                : '画像を読み込めませんでした。別のPNGを選んでください。'
        } finally {
          if (candidateUrl) URL.revokeObjectURL(candidateUrl)
        }
      }
      $('file').addEventListener('change', (event) => {
        const file = event.target.files[0]
        if (file) void load(file)
        event.target.value = ''
      })
      $('example').addEventListener('click', () => void load())
      $('reset').addEventListener('click', clear)
      $('background').addEventListener('change', () => {
        $('stage').dataset.background = $('background').value
      })
      for (const id of ['name', 'filename'])
        $(id).addEventListener('input', update)
      $('gender').addEventListener('change', update)
      $('stage').addEventListener('click', (event) => {
        const rect = $('photo').getBoundingClientRect()
        place(
          (event.clientX - rect.left) / rect.width,
          (event.clientY - rect.top) / rect.height,
        )
      })
      $('stage').addEventListener('keydown', (event) => {
        if (!ready) return
        if (event.key === 'Enter') {
          event.preventDefault()
          place(cursor.x, cursor.y)
          return
        }
        const delta = {
          ArrowLeft: [-1, 0],
          ArrowRight: [1, 0],
          ArrowUp: [0, -1],
          ArrowDown: [0, 1],
        }[event.key]
        if (!delta) return
        event.preventDefault()
        const step = event.shiftKey ? 0.001 : 0.01
        cursor = {
          x: Math.max(0, Math.min(1, cursor.x + delta[0] * step)),
          y: Math.max(0, Math.min(1, cursor.y + delta[1] * step)),
        }
        $('cursor').hidden = false
        $('cursor').style.left = cursor.x * 100 + '%'
        $('cursor').style.top = cursor.y * 100 + '%'
      })
      $('copy').addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText($('output').value)
          $('copy-status').textContent =
            'コピーしました。garments.ts の demoGarment を置き換えてください。'
        } catch {
          $('output').focus()
          $('output').select()
          $('copy-status').textContent =
            '設定を選択しました。Ctrl+C（Macは⌘C）でコピーしてください。'
        }
      })
      void load()
    </script>
  </body>
</html>
</file>

